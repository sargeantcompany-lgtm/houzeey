# Copy this to .env and fill in your values

# PostgreSQL — paste your Railway DATABASE_URL here
DATABASE_URL=postgresql://user:password@host:port/dbname

# JWT secret — generate a long random string
JWT_SECRET=your_super_secret_jwt_key_here

# The account registered with this email is granted admin access
ADMIN_EMAIL=admin@yourdomain.com

# Port (Railway sets this automatically)
PORT=3001

# Frontend URL for CORS (your Houzeey web app URL)
CLIENT_URL=https://www.houzeey.com

# Upload directory (Railway: mount a volume at /uploads for persistence)
UPLOAD_DIR=uploads

# SMTP Email — add these in Railway backend service Variables for email to work
# Configure these before using password resets, solicitor invitations, or marketing emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Houzeey" <no-reply@houzeey.com>

# Redis queue shared by the API and video worker
REDIS_URL=redis://localhost:6379

# Railway Storage Bucket S3-compatible credentials
BUCKET_ENDPOINT=https://t3.storageapi.dev
BUCKET_NAME=your-unique-bucket-name
BUCKET_ACCESS_KEY_ID=your-access-key-id
BUCKET_SECRET_ACCESS_KEY=your-secret-access-key
BUCKET_REGION=auto

# Video upload cap; the worker defaults to a 180-second maximum duration
MAX_VIDEO_UPLOAD_BYTES=536870912

# Email that receives a copy of every buyer/seller message (falls back to ADMIN_EMAIL)
MESSAGE_ALERT_EMAIL=
